# -----------------------------------------------
# required parameters

# strong point source uvfits file
poitsourceuvfits = ./data/EVN/gs039/gs039_1219+044.UVDATA.FITS

# target source uvfits file
visfile = ./data/EVN/gs039/gs039_1219+044.UVDATA.FITS

# win file in CLEAN step 
cleanwinfile = ./data/origin.win

# target source name for the name in save clean map 
targetsource = '1219+044'

# out directory
outdir = ./data/EVN/gs039

# map size 
mapsize = 512

# pixel size       
pixelsize = 0.02

# clean gain
clean_gain = 0.1

#clean sigma 
cleansigma = 8

# name of the interferometer
interferometer = EVN

#xy range
xyrange = '-10,10,-10,10' 
