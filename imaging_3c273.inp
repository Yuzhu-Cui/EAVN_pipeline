# -----------------------------------------------
# required parameters

# strong point source uvfits file
poitsourceuvfits = ./data/a17078a_1219+044.UVDATA.FITS

# target source uvfits file
visfile = ./data/a17078a_3C273.UVDATA.FITS

# win file in CLEAN step 
cleanwinfile = ./data/86-3C273final.win

# target source name for the name in save clean map 
targetsource = '3C273'

# out directory
outdir = ./data

# map size 
mapsize = 4096

# pixel size       
pixelsize = 0.02

# clean gain
clean_gain = 1.0

#clean sigma 
cleansigma = 8

# name of the interferometer
interferometer = EAVN

#xy range
xyrange = '-20,10,-20,10'
