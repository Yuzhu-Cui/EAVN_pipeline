# -----------------------------------------------
# required parameters
# strong point source uvfits file
poitsourceuvfits = ./data/BL250/BL250F/bl250f_OJ287.UVDATA.FITS

# target source uvfits file
visfile = ./data/BL250/BL250F/bl250f_M87.UVDATA.FITS

# win file in CLEAN step 
cleanwinfile = ./data/origin.win

# target source name for the name in save clean map 
targetsource = 'M87'

# out directory
outdir = ./data/BL250/BL250F

# map size 
mapsize = 2048

# pixel size       
pixelsize = 0.02

# clean gain
clean_gain = 1.0

#clean sigma 
cleansigma = 8

# name of the interferometer
interferometer = VLBA

