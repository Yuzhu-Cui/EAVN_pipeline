# -----------------------------------------------
# required parameters
# strong point source uvfits file
poitsourceuvfits = ./data/BW115A/bw115a_3C279.UVDATA.FITS

# target source uvfits file
visfile = ./data/BW115A/bw115a_3C274.UVDATA.FITS

# win file in CLEAN step 
cleanwinfile = ./data/origin.win

# target source name for the name in save clean map 
targetsource = '3C274'

# out directory
outdir = ./data/BW115A

# map size in pixel
mapsize = 1024

# pixel size in mas
pixelsize = 0.02

# clean gain
clean_gain = 1.0

#clean sigma 
cleansigma = 6

# name of the interferometer
interferometer = VLBA

# xy range in mas
xyrange = '-5,5,-5,5'
