# -----------------------------------------------
# required parameters
# strong point source uvfits file
poitsourceuvfits = 

# target source uvfits file
visfile = ./data/BL250/bl250_M87.UVDATA.FITS

# win file in CLEAN step 
cleanwinfile = ./data/origin.win

# target source name for the name in save clean map 
targetsource = 'M87'

# out directory
outdir = ./data/BL250

# map size 
mapsize = 1024

# pixel size       
pixelsize = 0.02

# clean gain
clean_gain = 1.0

#clean sigma 
cleansigma = 6

# name of the interferometer
interferometer = VLBA

